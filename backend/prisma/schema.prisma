// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  password          String
  role              String    @default("USER")
  resetToken        String?
  resetTokenExpiry  DateTime?
  preferredPaymentMethod String @default("COD")
  savedUpiId        String?
  createdAt         DateTime  @default(now())

  cart      Cart[]
  orders    Order[]
  customOrders CustomOrder[]
  addresses Address[]
}

model Promotion {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  type          String   // "PERCENT" | "FLAT" | "SHIPPING"
  value         Float    @default(0)
  minOrderValue Float    @default(0)
  active        Boolean  @default(true)
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int      @default(0)
  createdAt     DateTime @default(now())

  orders Order[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  price         Float
  originalPrice Float?
  stock         Int
  image         String
  images        String[] @default([])
  sizes         String?  // comma-separated, e.g. "S,M,L,XL" — legacy display-only, ignored once real variants exist
  colors        String?  // comma-separated hex codes — legacy display-only, ignored once real variants exist
  subcategory   String?
  active        Boolean  @default(true)
  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id])
  createdAt     DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
  variants   ProductVariant[]
  customOrdersAsSource CustomOrder[]
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  price     Float?   // optional override; null = use the parent product's price
  stock     Int      @default(0)
  sku       String?  @unique
  image     String?
  createdAt DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int?
  quantity  Int

  cart    Cart            @relation(fields: [cartId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
}

model Order {
  id            Int         @id @default(autoincrement())
  userId        Int
  subtotal      Float       @default(0)
  discount      Float       @default(0)
  shippingFee   Float       @default(0)
  total         Float
  status        OrderStatus @default(PENDING)
  paymentMethod String      @default("COD")
  shippingName  String?
  shippingPhone String?
  shippingLine1 String?
  shippingLine2 String?
  shippingCity  String?
  shippingState String?
  shippingPincode String?
  promotionId   Int?
  promotion     Promotion?  @relation(fields: [promotionId], references: [id])
  createdAt     DateTime    @default(now())

  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId   Int
  productId Int
  variantId Int?
  quantity  Int
  price     Float

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

// ─── Made For You (custom stitching) ───────────────────────────────────────

model CustomDesign {
  id        Int      @id @default(autoincrement())
  name      String
  image     String
  comboType String   // "Mom & Daughter" | "Sisters Combo" | "Designer Blouse" | ...
  tag       String?  // e.g. "New", "Trending"
  basePrice Float    // fabric/design cost — one-time, shared across all recipients in a combo
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  customOrders CustomOrder[]
}

// Global, admin-configurable stitching labor cost by standard size — applied per garment/recipient,
// on top of the one-time fabric cost, regardless of whether the fabric came from a design, a real
// store saree, or the customer's own material.
model StitchingSettings {
  id          Int      @id @default(1)
  sizePricing Json     // e.g. { "S": 499, "M": 599, "L": 699, "XL": 799, "XXL": 899 }
  ownFabricFee Float   @default(799) // flat fallback when a recipient's size isn't in sizePricing
  updatedAt   DateTime @updatedAt
}

model CustomOrder {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  designId Int?
  design   CustomDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)

  sourceProductId Int?
  sourceProduct   Product? @relation(fields: [sourceProductId], references: [id], onDelete: SetNull)

  comboType  String
  fabricType String  // "design" | "own" | "store-product"

  // One combo request can cover several people/garments cut from the same fabric —
  // e.g. a Mom & Daughter combo needs two separately sized garments from one saree.
  // Each entry: { label, sizeMode: "standard"|"custom", standardSize, measurements, stitchingCost }
  recipients Json

  // Stitching/tailoring details so the tailor knows exactly what to make — not just "notes".
  blouseType    String? // e.g. "Sleeveless", "Short Sleeve", "Full Sleeve", "3/4 Sleeve"
  neckPattern   String? // e.g. "Round", "Boat", "Sweetheart", "Collar", "Backless"
  backDesign    String? // e.g. "Regular", "Deep Back", "Keyhole", "Tie-Back"
  referenceImage String? // optional photo the customer uploads showing the exact look they want

  notes String?

  paymentMethod   String  @default("COD")
  shippingName    String?
  shippingPhone   String?
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?

  fabricCost    Float // one-time cost of the fabric/design (0 if customer supplied their own)
  stitchingCost Float // sum of every recipient's stitching cost
  price         Float // fabricCost + stitchingCost — grand total
  status        String @default("PENDING") // PENDING, CONFIRMED, IN_PROGRESS, SHIPPED, DELIVERED

  createdAt DateTime @default(now())
}

// Storefront hero banner (first carousel slide only). Headline/sub/CTA text
// stay hardcoded in the frontend — admins can only override the background.
// backgroundType "default" means "no override configured", so the frontend
// falls back to its built-in gradient.
model HeroBanner {
  id              Int      @id @default(1)
  backgroundType  String   @default("default") // "default" | "image" | "color"
  backgroundImage String?
  backgroundColor String?
  updatedAt       DateTime @updatedAt
}

// Admin-uploaded lifestyle photo for one "Shop by Category" card (key = "men" |
// "women" | "boys" | "girls", matching the frontend's hardcoded category keys).
// No row / null imageUrl means the frontend falls back to its default
// gradient + emoji card design.
model CategoryImage {
  key       String   @id
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  label     String  @default("Home") // e.g. "Home", "Work"
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String?
  pincode   String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
}
